# Copy to .env and fill in. Never commit .env.

# Database (Neon): pooled URL for the app, direct URL for migrations
DATABASE_URL=
DIRECT_URL=

# Auth.js (generate AUTH_SECRET with: npx auth secret) + Google OAuth
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# OpenAI (server-only). OPENAI_MODEL is optional; defaults to gpt-5.4-nano.
OPENAI_API_KEY=
OPENAI_MODEL=
